{
  "buildCommand": "chmod +x ./scripts/vercel_build.sh && ./scripts/vercel_build.sh",
  "outputDirectory": "build/web",
  "framework": null,
  "installCommand": "echo 'Skip install — handled in build script'",
  "headers": [
    {
      "source": "/sqlite3.wasm",
      "headers": [
        { "key": "Content-Type", "value": "application/wasm" },
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/drift_worker.js",
      "headers": [
        { "key": "Content-Type", "value": "application/javascript" },
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
